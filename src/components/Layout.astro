---
import '../styles/global.css';
import TopBar from './TopBar.astro';
import Crosshair from './Crosshair.tsx';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  canonicalPath?: string;
}

const {
  title,
  description = 'Navid Khan — software engineer in Oakville, ON.',
  ogType = 'website',
  publishedTime,
  canonicalPath,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="alternate" type="application/rss+xml" title="Navid Khan" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <TopBar />
    <Crosshair client:load />
    <slot />
  </body>
</html>
