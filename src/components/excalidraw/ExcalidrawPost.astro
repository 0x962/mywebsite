---
/**
 * Reusable page wrapper for an Excalidraw canvas post.
 *
 * Renders a full-screen Excalidraw canvas with proper SEO <head> pulled from
 * the post's `posts` collection entry (so the post still feeds home post-its
 * and RSS) and a small "back to nvdk.co" link overlaid clear of Excalidraw's
 * own UI. The scene itself is fetched client-side by ExcalidrawCanvas from
 * `GET /api/scenes/<slug>` (KV-backed) — the page never embeds it.
 *
 * Read-only for visitors; the author edits with ?edit. Writes are gated by
 * Cloudflare Access in production.
 *
 * Usage (one thin page per post):
 *   ---
 *   import ExcalidrawPost from '../../components/excalidraw/ExcalidrawPost.astro';
 *   ---
 *   <ExcalidrawPost slug="<slug>" />
 */
import '../../styles/global.css';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import { getEntry } from 'astro:content';
import TopBar from '../TopBar.astro';
import ExcalidrawCanvas from './ExcalidrawCanvas.tsx';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const entry = await getEntry('posts', slug);
if (!entry) throw new Error(`ExcalidrawPost: no post entry for slug "${slug}"`);
const { title, date, summary } = entry.data;

const canonical = new URL(`/wip/${slug}/`, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
const pageTitle = `${title} — Navid Khan — WIP`;
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: 'Navid Khan', url: 'https://nvdk.co/' },
  mainEntityOfPage: canonical.toString(),
  url: canonical.toString(),
  image: ogImage.toString(),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Navid Khan" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />

    <title>{pageTitle}</title>
    <meta name="description" content={summary} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content="Navid Khan — WIP" />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="article:published_time" content={date.toISOString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={ogImage.toString()} />

    <link rel="alternate" type="application/rss+xml" title="Navid Khan — WIP" href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />

    <style>
      html, body {
        margin: 0;
        height: 100%;
        background: #0a0a0b;
      }
      /* Push the canvas below the site topbar so Excalidraw's own toolbar
         doesn't fight with it. ExcalidrawCanvas uses `position: fixed`
         inside; the global CSS rule below moves its top edge. */
      .excalidraw-stage {
        position: fixed;
        top: var(--topbar-height, 56px);
        left: 0; right: 0; bottom: 0;
      }
      .ex-edited {
        position: fixed;
        top: calc(var(--topbar-height, 56px) + 12px);
        left: 16px;
        z-index: 5;
        font: 11px/1 'JetBrains Mono', ui-monospace, monospace;
        color: #71717a;
        background: rgba(15, 15, 16, 0.65);
        border: 1px solid #27272a;
        border-radius: 6px;
        padding: 6px 9px;
        letter-spacing: 0.02em;
        pointer-events: none;
      }
      .ex-edited:empty { display: none; }
    </style>
  </head>
  <body>
    <TopBar />
    <span class="ex-edited" data-slug={slug}></span>
    <ExcalidrawCanvas client:only="react" slug={slug} />
    <script is:inline define:vars={{ slug }}>
      // Show "edited X ago" overlay near the topbar. Failure is silent.
      (async () => {
        const el = document.querySelector(`.ex-edited[data-slug="${slug}"]`);
        if (!el) return;
        try {
          const res = await fetch(`/data/meta/${encodeURIComponent(slug)}`, { cache: 'no-store' });
          if (!res.ok) return;
          const { lastEditedAt } = await res.json();
          if (!lastEditedAt) return;
          const sec = Math.max(0, (Date.now() - Date.parse(lastEditedAt)) / 1000);
          let ago;
          if (sec < 90) ago = 'just now';
          else if (sec < 3600) ago = `${Math.round(sec / 60)}m ago`;
          else if (sec < 36 * 3600) ago = `${Math.round(sec / 3600)}h ago`;
          else if (sec < 14 * 86400) ago = `${Math.round(sec / 86400)}d ago`;
          else if (sec < 70 * 86400) ago = `${Math.round(sec / (7 * 86400))}w ago`;
          else if (sec < 540 * 86400) ago = `${Math.round(sec / (30.4 * 86400))}mo ago`;
          else ago = `${Math.round(sec / (365.25 * 86400))}y ago`;
          el.textContent = `edited ${ago}`;
        } catch { /* leave empty */ }
      })();
    </script>
  </body>
</html>
