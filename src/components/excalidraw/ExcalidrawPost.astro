---
/**
 * Reusable page wrapper for an Excalidraw canvas post.
 *
 * Renders a full-screen Excalidraw canvas with proper SEO <head> pulled from
 * the post's `posts` collection entry (so the post still feeds home post-its
 * and RSS) and a small "back to nvdk.co" link overlaid clear of Excalidraw's
 * own UI. The scene itself is fetched client-side by ExcalidrawCanvas from
 * `GET /api/scenes/<slug>` (KV-backed) — the page never embeds it.
 *
 * Read-only for visitors; the author edits with ?edit. Writes are gated by
 * Cloudflare Access in production.
 *
 * Usage (one thin page per post):
 *   ---
 *   import ExcalidrawPost from '../../components/excalidraw/ExcalidrawPost.astro';
 *   ---
 *   <ExcalidrawPost slug="<slug>" />
 */
import { getEntry } from 'astro:content';
import ExcalidrawCanvas from './ExcalidrawCanvas.tsx';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const entry = await getEntry('posts', slug);
if (!entry) throw new Error(`ExcalidrawPost: no post entry for slug "${slug}"`);
const { title, date, summary } = entry.data;

const canonical = new URL(`/wip/${slug}/`, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
const pageTitle = `${title} — Navid Khan`;
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: 'Navid Khan', url: 'https://nvdk.co/' },
  mainEntityOfPage: canonical.toString(),
  url: canonical.toString(),
  image: ogImage.toString(),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Navid Khan" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />

    <title>{pageTitle}</title>
    <meta name="description" content={summary} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content="Navid Khan" />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="article:published_time" content={date.toISOString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={ogImage.toString()} />

    <link rel="alternate" type="application/rss+xml" title="Navid Khan" href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />

    <style>
      html, body {
        margin: 0;
        height: 100%;
        background: #0a0a0b;
      }
      .ex-home-link {
        position: fixed;
        top: 14px;
        right: 16px;
        z-index: 5;
        font: 13px/1 'JetBrains Mono', ui-monospace, monospace;
        color: #d4d4d8;
        text-decoration: none;
        background: rgba(15, 15, 16, 0.85);
        border: 1px solid #27272a;
        border-radius: 6px;
        padding: 7px 10px;
      }
      .ex-home-link:hover {
        color: #fff;
        border-color: #3b82f6;
      }
    </style>
  </head>
  <body>
    <a class="ex-home-link" href="/">← nvdk.co</a>
    <ExcalidrawCanvas client:only="react" slug={slug} />
  </body>
</html>
