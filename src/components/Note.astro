---
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---
<aside class="margin-note" data-note-id={id}>
  <span class="margin-label">{label}</span>
  <slot />
</aside>
<aside class="inline-footnote" data-note-id={id}>
  <span class="margin-label">{label}</span>
  <slot />
</aside>
