---
/**
 * Canvas — the open-workspace stage.
 *
 * Establishes a bounded, scroll-only design stage. Authoring happens in plain
 * design-pixels on a fixed design width per breakpoint; the controller
 * (src/scripts/canvas.ts) scales the whole stage uniformly to fit the viewport
 * (capped at 1×, so wide screens get centered black margins) and sets the
 * flowed height. Children are positioned with <Place>. One <Canvas> per page.
 *
 * Design widths/heights per breakpoint are design-pixels, not CSS pixels —
 * they describe the coordinate space you author in, then everything scales.
 */
interface Props {
  /** Page key — used for the dev editor's saved-layout file (<page>.json). */
  page: string;
  /** Desktop (≥1024px) design width / height, in design-px. */
  width?: number;
  height: number;
  /** Tablet (640–1023px) overrides. Fall back to desktop if omitted. */
  tabletWidth?: number;
  tabletHeight?: number;
  /** Mobile (<640px) overrides. Fall back to tablet if omitted. */
  mobileWidth?: number;
  mobileHeight?: number;
  /** Cap the zoom-to-fill scale (default: uncapped). */
  maxScale?: number;
  /** Let any visitor drag placed items around (the public "desktop"). */
  interactive?: boolean;
  class?: string;
}

const {
  page,
  width = 1280,
  height,
  tabletWidth = 760,
  tabletHeight = height,
  mobileWidth = 380,
  mobileHeight = tabletHeight,
  maxScale,
  interactive = false,
  class: className,
} = Astro.props;

const vars = [
  `--cv-dw-d:${width}`,
  `--cv-h-d:${height}`,
  `--cv-dw-t:${tabletWidth}`,
  `--cv-h-t:${tabletHeight}`,
  `--cv-dw-m:${mobileWidth}`,
  `--cv-h-m:${mobileHeight}`,
  ...(maxScale ? [`--cv-max-scale:${maxScale}`] : []),
].join(';');
---
<div class:list={['canvas', className]} data-canvas data-cv-page={page} data-cv-interactive={interactive ? '' : undefined} style={vars}>
  <div class="canvas-stage" data-canvas-stage>
    <slot />
  </div>
</div>

<script>
  import { initCanvases } from '../../scripts/canvas';
  initCanvases();

  // Two mutually-exclusive interaction layers:
  //  • dev `?edit`  → the authoring drag editor (saves the committed build file);
  //                   dev-only, dead-code-eliminated from prod.
  //  • interactive  → the public "desktop": any visitor can drag tiles, guests
  //                   persist locally, the owner persists to R2 for everyone.
  if (import.meta.env.DEV && new URLSearchParams(location.search).has('edit')) {
    import('../../scripts/canvas-editor').then((m) => m.initCanvasEditor());
  } else if (document.querySelector('[data-canvas][data-cv-interactive]')) {
    import('../../scripts/canvas-desktop').then((m) => m.initCanvasDesktop());
  }
</script>
