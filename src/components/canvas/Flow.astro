---
/**
 * Flow — a small hand-drawn vertical pipeline diagram (PaperCSS wobbly boxes
 * joined by ↓ arrows). For showing a process on the canvas: each step is a
 * box; an optional `flag` hangs a red annotation off a step. Drop inside a
 * <Place> and size it with the Place width.
 *
 * steps: Array<{ text: string; flag?: string }>
 */
interface Step {
  text: string;
  flag?: string;
}
interface Props {
  label?: string;
  steps: Step[];
  accent?: string;
  class?: string;
}
const { label, steps, accent = 'var(--accent-color)', class: className } = Astro.props;
---
<figure class:list={['flow', className]} style={`--flow-accent:${accent}`}>
  {label && <figcaption class="flow-label">{label}</figcaption>}
  <div class="flow-steps">
    {steps.map((s, i) => (
      <>
        <div class="flow-box">
          <span class="flow-text">{s.text}</span>
          {s.flag && <span class="flow-flag">{s.flag}</span>}
        </div>
        {i < steps.length - 1 && <span class="flow-arrow" aria-hidden="true">↓</span>}
      </>
    ))}
  </div>
</figure>

<style>
  .flow {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--text-primary);
  }
  .flow-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--flow-accent);
    margin-bottom: 12px;
  }
  .flow-steps {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .flow-box {
    position: relative;
    width: 100%;
    text-align: center;
    padding: 10px 14px;
    border: 2px solid var(--text-secondary);
    /* PaperCSS wobble */
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: rgba(255, 255, 255, 0.015);
  }
  .flow-text {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-primary);
  }
  .flow-flag {
    display: block;
    margin-top: 5px;
    font-family: 'Caveat', var(--font-serif);
    font-size: 1.05rem;
    line-height: 1;
    color: #ef6a6a;
  }
  .flow-arrow {
    color: var(--flow-accent);
    font-size: 1.1rem;
    line-height: 1;
    padding: 5px 0;
  }
</style>
