---
/**
 * Doodle — little hand-drawn line-art doodles, rendered to static inline SVG at
 * build time via roughjs (sketchy, deterministic, crawlable, zero client JS).
 * Each doodle is authored as SVG subpaths in its own viewBox; `stroke` paths are
 * outlined, `fill` paths are solid-filled. Colour comes from the `color` prop
 * (emitted as currentColor). Position/rotate with a wrapping <Place>.
 */
import rough from 'roughjs/bundled/rough.esm.js';

// cx,cy,r → a small circle path (used for eyes, pips, spots).
const dot = (cx: number, cy: number, r: number) =>
  `M${cx} ${cy} m${-r} 0 a${r} ${r} 0 1 0 ${r * 2} 0 a${r} ${r} 0 1 0 ${-r * 2} 0`;

