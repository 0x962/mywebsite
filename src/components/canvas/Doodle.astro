interface Props {
  name: keyof typeof DOODLES;
  /** Rendered height in design-px (width follows the doodle's aspect). */
  size?: number;
  color?: string;
  seed?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 80, color = 'var(--text-secondary)', seed = 1, strokeWidth = 2, class: className } = Astro.props;
const d = DOODLES[name];

const gen = rough.generator();
const strokePaths = (d.stroke ?? []).flatMap((pd) =>
  gen.toPaths(gen.path(pd, { seed, roughness: 1.1, strokeWidth, stroke: '#000' })),
);
const fillPaths = (d.fill ?? []).flatMap((pd) =>
  gen.toPaths(gen.path(pd, { seed, roughness: 0.9, strokeWidth: 0.8, stroke: '#000', fill: '#000', fillStyle: 'solid' })),
);
const paths = [...fillPaths, ...strokePaths];

const h = size;
const w = Math.round((size * d.w) / d.h);
const colorOf = (v: string | undefined) => (v && v !== 'none' ? 'currentColor' : 'none');
---
<svg
  class:list={['cv-doodle', className]}
  width={w}
  height={h}
  viewBox={`0 0 ${d.w} ${d.h}`}
  fill="none"
  style={`color:${color}`}
  aria-hidden="true"
  role="presentation"
>
  {paths.map((p) => (
    <path
      d={p.d}
      stroke={colorOf(p.stroke)}
      stroke-width={p.strokeWidth}
      fill={colorOf(p.fill)}
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  ))}
</svg>

<style>
  .cv-doodle { display: block; overflow: visible; pointer-events: none; }
</style>
