---
/**
 * CanvasItem — renders one owner-authored canvas item (link, post-it, text,
 * image or borderless embed) inside the open-workspace stage. Position/rotate
 * is handled by the wrapping <Place>; this only paints the content.
 */
import type { CanvasItem } from '../../lib/items';

interface Props {
  item: CanvasItem;
}
const { item } = Astro.props;
const { kind } = item;

// Post-it paper colours (dark ink). `white` is a clean white note.
const POSTIT: Record<string, { paper: string; ink: string }> = {
  amber: { paper: '#e6cd7e', ink: '#26231c' },
  blue: { paper: '#aecbe2', ink: '#16222e' },
  green: { paper: '#b9d4a2', ink: '#1c2914' },
  pink: { paper: '#e6b6bf', ink: '#2c151a' },
  paper: { paper: '#e9e3d5', ink: '#26231c' },
  white: { paper: '#fbfbf7', ink: '#222' },
};
// Free-text ink colours (text sits on the dark stage).
const INK: Record<string, string> = {
  amber: '#e6cd7e',
  blue: '#aecbe2',
  green: '#b9d4a2',
  pink: '#e6b6bf',
  paper: '#e9e3d5',
  white: '#ffffff',
};

const pi = POSTIT[item.color ?? 'amber'] ?? POSTIT.amber;
const ink = INK[item.color ?? 'white'] ?? INK.white;
---
{kind === 'link' && (
  <a class="ci-link" href={item.href} target="_blank" rel="noopener" style={`--ink:${ink}`}>
    <span class="ci-link-label">{item.title}</span>
    <span class="ci-link-arrow" aria-hidden="true">↗</span>
  </a>
)}

{kind === 'text' && (
  <div class="ci-text" style={`--ink:${ink}`}>{item.text}</div>
)}

{kind === 'postit' && (
  <Fragment>
    {item.href ? (
      <a class="ci-postit" href={item.href} target="_blank" rel="noopener" style={`--paper:${pi.paper};--ink:${pi.ink}`}>
        {item.title && <span class="ci-postit-title">{item.title}</span>}
        {item.text && <span class="ci-postit-body">{item.text}</span>}
      </a>
    ) : (
      <div class="ci-postit" style={`--paper:${pi.paper};--ink:${pi.ink}`}>
        {item.title && <span class="ci-postit-title">{item.title}</span>}
        {item.text && <span class="ci-postit-body">{item.text}</span>}
      </div>
    )}
  </Fragment>
)}

{kind === 'image' && (
  item.href ? (
    <a class="ci-image" href={item.href} target="_blank" rel="noopener">
      <img src={item.src} alt={item.title ?? ''} loading="lazy" />
    </a>
  ) : (
    <span class="ci-image">
      <img src={item.src} alt={item.title ?? ''} loading="lazy" />
    </span>
  )
)}

{kind === 'embed' && (
  <div class="ci-embed" style={`height:${item.h ?? 360}px`}>
    <iframe
      src={item.src}
      title={item.title ?? 'embed'}
      loading="lazy"
      frameborder="0"
      allowfullscreen
      referrerpolicy="no-referrer"
      sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
    ></iframe>
  </div>
)}

<style>
  /* link — a handwritten margin link with a hand-drawn underline. Folds onto
     multiple lines when the label is long rather than running off the desk. */
  .ci-link {
    display: inline-block;
    max-width: 260px;
    color: var(--ink);
    font-family: 'Caveat', 'IBM Plex Serif', Georgia, serif;
    font-size: 1.7rem;
    line-height: 1.25;
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--accent-color);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }
  .ci-link:hover {
    color: #fff;
    text-decoration-color: #fff;
  }
  .ci-link-arrow {
    display: inline-block; /* keeps the wavy underline from crossing the arrow */
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-color);
  }

  /* free text */
  .ci-text {
    font-family: 'Caveat', 'IBM Plex Serif', Georgia, serif;
    font-size: 1.7rem;
    line-height: 1.3;
    color: var(--ink);
    white-space: pre-wrap;
  }

  /* post-it note */
  .ci-postit {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 100%;
    padding: 16px 18px 18px;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    border-radius: 2px;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.4), 0 10px 22px rgba(0, 0, 0, 0.45);
    background-image: linear-gradient(135deg, transparent 88%, rgba(0, 0, 0, 0.12) 100%);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  a.ci-postit:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 2px rgba(0, 0, 0, 0.4), 0 18px 34px rgba(0, 0, 0, 0.55);
  }
  .ci-postit-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .ci-postit-body {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--ink) 72%, transparent);
    white-space: pre-wrap;
  }

  /* image */
  .ci-image,
  .ci-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .ci-image img {
    border-radius: 3px;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.4), 0 12px 26px rgba(0, 0, 0, 0.5);
  }

  /* borderless embed */
  .ci-embed {
    width: 100%;
    overflow: hidden;
    border-radius: 6px;
    background: #0a0a0b;
  }
  .ci-embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    a.ci-postit:hover, .ci-link:hover { transform: none; }
  }
</style>
