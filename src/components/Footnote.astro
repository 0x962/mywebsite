---
/**
 * Inline numbered footnote. The ref increments a CSS counter; both the ref
 * and the marginalia/inline body read the same counter value, so the number
 * always agrees regardless of which body is visible at the current breakpoint.
 */
---
<sup class="footnote-ref" aria-hidden="true"></sup>
<aside class="margin-note footnote-body">
  <span class="footnote-marker"></span>
  <slot />
</aside>
<aside class="inline-footnote footnote-body">
  <span class="footnote-marker"></span>
  <slot />
</aside>
