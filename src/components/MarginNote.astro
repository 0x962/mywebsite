---
/**
 * A handwritten side note pinned to the right margin, pointing at
 * an <Anchor id="..."> in the article. The annotations.ts script
 * positions it next to its anchor and draws a rough-notation bracket
 * or a roughjs arrow between them.
 */
interface Props {
  for: string;
  style?: 'bracket' | 'underline' | 'circle' | 'arrow' | 'box';
}
const { for: target, style = 'bracket' } = Astro.props;
---
<aside class="ann-note" data-target={target} data-style={style}>
  <slot />
</aside>

<style>
  .ann-note {
    /* Hidden until annotations.ts measures and positions it. Prevents
       a flash of inline content before the layout pass. annotations.ts
       sets left + right so the note fills the rail and never clips the
       viewport; width stays auto. */
    position: absolute;
    visibility: hidden;
    left: -9999px;
    top: -9999px;
    font-family: 'Caveat', 'IBM Plex Serif', Georgia, serif;
    font-size: 1.4rem;
    line-height: 1.3;
    color: #e8e8ea;
    transform: rotate(-0.6deg);
    transform-origin: left center;
    z-index: 2;
    pointer-events: none;
  }
  @media (max-width: 900px) {
    /* On narrow viewports there's no right rail — render inline,
       small and indented, as a margin-style aside. */
    .ann-note {
      position: static;
      visibility: visible;
      display: block;
      margin: 0.5rem 0 1.25rem 1.25rem;
      width: auto;
      font-size: 1.3rem;
      transform: rotate(-0.3deg);
    }
  }
</style>
