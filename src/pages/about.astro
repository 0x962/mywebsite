---
export const prerender = true;
import Layout from '../components/Layout.astro';
import Canvas from '../components/canvas/Canvas.astro';
import Place from '../components/canvas/Place.astro';
import Polaroid from '../components/canvas/Polaroid.astro';
import Scribble from '../components/canvas/Scribble.astro';
import Doodle from '../components/canvas/Doodle.astro';
import { loadLayout } from '../utils/layout';

const layout = loadLayout('about');

// A doodle-filled footer band. Positions are a per-breakpoint grid (desktop 7
// across, tablet 4, mobile 3) so the scatter just works at any width; drag with
// ?edit to scatter them further.
const doodles = [
  // places we've been
  { name: 'aeroplane', color: '#9aa7b3', size: 60 },
  { name: 'maple-leaf', color: '#e0584a', size: 60 },      // Canada
  { name: 'india-gate', color: '#d4b483', size: 78 },      // India
  { name: 'penguin', color: '#cfd8e0', size: 72 },         // Antarctica
  { name: 'cactus', color: '#7cc46a', size: 60 },          // Mexico
  { name: 'coffee', color: '#c08457', size: 56 },          // Colombia
  { name: 'telephone-box', color: '#e0556a', size: 66 },   // UK
  { name: 'shamrock', color: '#6cc46a', size: 58 },        // Ireland
  { name: 'nessie', color: '#5fb0a0', size: 60 },          // Scotland
  { name: 'elephant', color: '#9bb0c0', size: 62 },        // Thailand
  { name: 'palm', color: '#8cc46a', size: 66 },            // Maldives
  { name: 'prayer-flags', color: '#e0a96a', size: 56 },    // Bhutan
  { name: 'mountains', color: '#6aa9e0', size: 56 },
  { name: 'sailboat', color: '#6aa9e0', size: 62 },
  // animals (Aditi)
  { name: 'cat', color: '#e0975a', size: 60 },
  { name: 'giraffe', color: '#e8b35a', size: 80 },
  { name: 'fish', color: '#6cc0c0', size: 58 },
  { name: 'butterfly', color: '#d98ad0', size: 60 },
  { name: 'paw', color: '#c79a6a', size: 46 },
  { name: 'snake', color: '#7ccf9a', size: 50 },
  // technology (Navid)
  { name: 'robot', color: '#8fb0d0', size: 62 },
  { name: 'laptop', color: '#9aa7b3', size: 58 },
  // reading / books
  { name: 'book', color: '#e0a96a', size: 56 },
  { name: 'books', color: '#c08457', size: 58 },
  // home & fun
  { name: 'love', color: '#ff5d73', size: 50 },
  { name: 'house', color: '#e0a96a', size: 58 },
  { name: 'forest', color: '#7cc46a', size: 62 },
  { name: 'snowboard', color: '#6ad0d0', size: 64 },
  { name: 'dice', color: '#b794e0', size: 52 },
  { name: 'sun', color: '#f6b73c', size: 56 },
  { name: 'flower', color: '#ef8aa6', size: 54 },
  { name: 'icecream', color: '#f0a6c0', size: 54 },
] as const;
// Footer doodles: each used exactly once, pseudo-randomly scattered across the
// whole bottom (no repeats, no grid pattern). A base slot per index guarantees
// full-width coverage; per-axis jitter breaks the pattern. The canvas height is
// DERIVED from the lowest doodle so the pile is flush with the page's bottom
// edge — zero space below it.
const rnd = (i: number, s: number) => {
  const v = Math.sin((i + 1) * 12.9898 + s * 78.233) * 43758.5453;
  return v - Math.floor(v);
};
const footerW = { desktop: 1280, tablet: 760, mobile: 380 };
const bandTop = { desktop: 3500, tablet: 6580, mobile: 9100 };
const BAND_H = 122;
const footerPos = (dd: (typeof doodles)[number], i: number, bp: keyof typeof footerW, sx: number, sy: number) => {
  const w = footerW[bp];
  const step = w / doodles.length;
  const size = Math.round(dd.size * 0.78);
  const rightPad = bp === 'mobile' ? 22 : Math.round(size * 1.3);
  let x = Math.round(step * (i + 0.5) + (rnd(i, sx) - 0.5) * step * 1.25 - size / 2);
  x = Math.max(2, Math.min(w - rightPad, x));
  const y = Math.round(bandTop[bp] + rnd(i, sy) * BAND_H);
  return { x, y, size };
};
const fp = {
  desktop: doodles.map((dd, i) => footerPos(dd, i, 'desktop', 1, 7)),
  tablet: doodles.map((dd, i) => footerPos(dd, i, 'tablet', 2, 8)),
  mobile: doodles.map((dd, i) => footerPos(dd, i, 'mobile', 3, 9)),
};
const footerRot = doodles.map((_, i) => Math.round((rnd(i, 11) - 0.5) * 38));
const lowest = (arr: { y: number; size: number }[]) => Math.max(...arr.map((p) => p.y + p.size));
const footerH = { d: lowest(fp.desktop), t: lowest(fp.tablet), m: lowest(fp.mobile) };

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Navid Khan',
  url: 'https://nvdk.co/',
  image: 'https://nvdk.co/images/profile.png',
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Canary Technologies' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Oakville',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  description: 'Software engineer in Oakville, Ontario. Currently at Canary Technologies; previously founded Big Drop and Square1.',
};
---
<Layout
  title="About — Navid Khan — WIP"
  description="About Navid Khan — software engineer in Oakville, Ontario. Currently at Canary Technologies; previously founded Big Drop and Square1."
  jsonLd={personLd}
>
  <div class="canvas-page">
    <Canvas page="about" width={1280} height={footerH.d} tabletHeight={footerH.t} mobileHeight={footerH.m}>
      <h1 class="sr-only">About Navid Khan</h1>

      {/* ===== Header + portrait ===== */}
      <Place id="header" saved={layout.header}
        x={96} y={36} rotate={-2} z={3} w={420}
        tablet={{ x: 40, y: 20, rotate: -2, w: 420 }}
        mobile={{ x: 20, y: 12, rotate: -2, w: 340 }}>
        <div class="scrap-head">
          <span class="scrap-title">about me</span>
          <Scribble type="underline" w={208} h={16} seed={6} color="var(--accent-color)" />
        </div>
      </Place>

      <Place id="portrait" saved={layout.portrait}
        x={808} y={20} rotate={-3} z={4} w={250}
        tablet={{ x: 260, y: 289, rotate: -3, w: 240 }}
        mobile={{ x: 80, y: 445, rotate: -3, w: 220 }}>
        <Polaroid src="/images/profile.png" alt="Portrait of Navid Khan" caption="me" />
      </Place>

      {/* ===== Act 1 — place ===== */}
      <Place id="t-intro" saved={layout['t-intro']}
        x={96} y={140} w={560}
        tablet={{ x: 40, y: 141, w: 600 }}
        mobile={{ x: 20, y: 134, w: 340 }}>
        <div class="scrap-text">
          <p>Hi, I'm Navid. I'm a software engineer (I think?).</p>
          <p>I grew up in <strong>Siliguri</strong> — a small city in the foothills of the
          Himalayas, in West Bengal, India. It's a long way from here.</p>
        </div>
      </Place>

      {/* "(I think?)" annotation — arrow and note as separate items so each rotates on its own */}
      <Place id="think-arrow" saved={layout['think-arrow']}
        x={486} y={150} rotate={180} z={6}
        tablet={{ x: 470, y: 150, rotate: 180 }}
        mobile={{ x: 36, y: 312, rotate: -108 }}>
        <Scribble type="arrow" w={64} h={38} seed={4} color="var(--text-secondary)" />
      </Place>

      <Place id="think-text" saved={layout['think-text']}
        x={560} y={140} rotate={-3} z={6} w={210}
        tablet={{ x: 545, y: 140, rotate: -3, w: 210 }}
        mobile={{ x: 96, y: 318, rotate: -3, w: 210 }}>
        <span class="scrap-hand">(AI has taken over)</span>
      </Place>

      <Place id="map" saved={layout.map}
        x={756} y={389} rotate={2} z={2} w={290}
        tablet={{ x: 240, y: 665, rotate: 2, w: 280 }}
        mobile={{ x: 40, y: 799, rotate: 2, w: 300 }}>
        <Polaroid src="/images/siliguri-map.png" alt="Map of South Asia with Siliguri marked between Nepal, Bhutan, and Bangladesh" caption="South Asia — Siliguri marked" />
      </Place>

      <Place id="t-coconut" saved={layout['t-coconut']}
        x={112} y={347} rotate={0.4} w={560}
        tablet={{ x: 40, y: 1025, w: 600 }}
        mobile={{ x: 20, y: 1183, w: 340 }}>
        <div class="scrap-text">
          <p>It was a quiet town then, with weather that still knew how to behave — this was
          before global warming taught it otherwise. Now Siliguri boils for most of the year, like
          the rest of the country.</p>
          <p>Coconut palms<Doodle name="palm" size={20} color="#8cc46a" seed={5} class="word-doodle" /> grew everywhere, leaning over walls and rooftops. One grew right outside
          our building, and it grew up alongside me. When we moved in, its fronds barely reached my
          second-floor window; by the time I finished school it had overtaken the building. We'd
          reach out, catch a leaf, and rock the whole tree until a coconut came down — then take a
          screwdriver and a hammer from my father's toolbox and punch three neat holes through the
          shell to drink the water inside. <span class="muted">(In India the floor on the ground is
          the ground floor — number zero. North America starts counting at one, which is, of course,
          wrong.)</span></p>
        </div>
      </Place>

      <Place id="t-bus" saved={layout['t-bus']}
        x={88} y={763} rotate={-0.4} w={560}
        tablet={{ x: 40, y: 1412, w: 600 }}
        mobile={{ x: 20, y: 1866, w: 340 }}>
        <div class="scrap-text">
          <p>Down the same road, a little shop at the corner doubled as our bus stop. Every morning
          we waited there in the half-light for the school bus — really just a city bus, moonlighting.
          Once the children were dropped off, the driver swapped the board on the front and spent the
          day ferrying strangers around town, the fares painted along its flank, until it was time to
          come back for us.</p>
          <p>Inside it was dark and close, a small television up front and speakers wired along the
          roof, music playing the whole way — mostly whatever the radio gave him. That's how I learned
          my pop and my Bollywood. RJ Naved was big in those years; same name as me, spelled
          differently, his voice filling the bus on the long ride. An hour there, an hour back.</p>
        </div>
      </Place>

      <Place id="t-bicycle" saved={layout['t-bicycle']}
        x={108} y={1150} rotate={0.5} w={560}
        tablet={{ x: 40, y: 1711, w: 600 }}
        mobile={{ x: 20, y: 2490, w: 340 }}>
        <div class="scrap-text">
          <p>There was a wide, dusty playground nearby with a few half-broken rides, and I spent
          most of my childhood on a bicycle — first a small red one, then a bigger black one —
          riding to every friend's house in town. I still carry the entire map of Siliguri in my
          head.</p>
        </div>
      </Place>

      {/* Siliguri trio — a row of small snapshots on desktop, stacked on narrow screens */}
      <Place id="p-city" saved={layout['p-city']}
        x={686} y={900} rotate={-3} z={2} w={158}
        tablet={{ x: 267, y: 1878, rotate: -3, w: 226 }}
        mobile={{ x: 40, y: 2747, rotate: -3, w: 300 }}>
        <Polaroid src="/images/siliguri-city.jpg" alt="Aerial view of Siliguri" caption="Siliguri" />
      </Place>

      <Place id="p-tea" saved={layout['p-tea']}
        x={858} y={900} rotate={2} z={2} w={158}
        tablet={{ x: 267, y: 2101, rotate: 2, w: 226 }}
        mobile={{ x: 40, y: 3020, rotate: 2, w: 300 }}>
        <Polaroid src="/images/siliguri-tea.jpg" alt="Tea gardens around Siliguri" caption="tea gardens" />
      </Place>

      <Place id="p-bridge" saved={layout['p-bridge']}
        x={1030} y={900} rotate={-2} z={2} w={158}
        tablet={{ x: 235, y: 2320, rotate: -2, w: 290 }}
        mobile={{ x: 30, y: 3287, rotate: -2, w: 320 }}>
        <Polaroid src="/images/siliguri-bridge.jpg" alt="Coronation Bridge over the Teesta near Siliguri" caption="Coronation Bridge" />
      </Place>

      <Place id="t-move" saved={layout['t-move']}
        x={96} y={1316} rotate={-0.4} w={560}
        tablet={{ x: 40, y: 2628, w: 600 }}
        mobile={{ x: 20, y: 3622, w: 340 }}>
        <div class="scrap-text">
          <p>I've never known a city that completely since. I spent about ten years in the
          Delhi–Gurgaon sprawl after school and learned the routes between home and work and a
          handful of friends, but never the whole of it. Part of that is just maps: once your phone
          holds the map for you, you stop building one of your own.</p>
          <p>In 2023, I moved to Toronto.</p>
        </div>
      </Place>

      <Place id="t-aditi" saved={layout['t-aditi']}
        x={104} y={1556} rotate={0.4} w={560}
        tablet={{ x: 40, y: 2868, w: 600 }}
        mobile={{ x: 20, y: 3953, w: 340 }}>
        <div class="scrap-text">
          <p>I live here with <span class="aditi-name"><strong>Aditi</strong><Scribble type="heart" w={14} h={12} color="#ff5d73" roughness={0.9} strokeWidth={1.4} seed={3} class="mh mh1" /><Scribble type="heart" w={10} h={9} color="#ff9ecb" roughness={0.9} strokeWidth={1.3} seed={5} class="mh mh2" /><Scribble type="heart" w={12} h={11} color="#ff5d73" roughness={0.9} strokeWidth={1.4} seed={7} class="mh mh3" /><Scribble type="heart" w={9} h={8} color="#ff9ecb" roughness={0.9} strokeWidth={1.3} seed={9} class="mh mh4" /></span>, my wife. I'm prouder of her than of anything
          I've built — of who she is, and of the work she does at <a href="https://womenfirstfund.org/" rel="noopener">Women First</a>.
          I keep telling her to put something on <a href="https://aditipadiyar.com" rel="noopener">aditipadiyar.com</a>;
          maybe one day you'll find something there. She loves animals; we both read more than we
          have any business doing<Doodle name="book" size={18} color="#e0a96a" seed={4} class="word-doodle" />; and we travel any chance we
          get<Doodle name="aeroplane" size={20} color="#9aa7b3" seed={6} class="word-doodle" />. We share our home with two cats, <strong>Obi</strong> and
          <strong>Zuzu</strong> — the soul of my life.</p>
        </div>
      </Place>

      {/* Cats — a pair on desktop, stacked on narrow screens */}
      <Place id="p-obi" saved={layout['p-obi']}
        x={700} y={1460} rotate={3} z={2} w={230}
        tablet={{ x: 235, y: 3063, rotate: 3, w: 290 }}
        mobile={{ x: 40, y: 4326, rotate: 3, w: 300 }}>
        <Polaroid src="/images/obi.jpg" alt="Obi, our long-haired grey cat, asleep on a window hammock" caption="Obi" />
      </Place>

      <Place id="p-zuzu" saved={layout['p-zuzu']}
        x={946} y={1460} rotate={-3} z={2} w={220}
        tablet={{ x: 235, y: 3534, rotate: -3, w: 290 }}
        mobile={{ x: 40, y: 4815, rotate: -3, w: 300 }}>
        <Polaroid src="/images/zuzu.jpg" alt="Zuzu, our tabby cat with a white belly, curled up grooming" caption="Zuzu" />
      </Place>

      <Place id="t-canada" saved={layout['t-canada']}
        x={92} y={1766} rotate={-0.3} w={560}
        tablet={{ x: 40, y: 4126, w: 600 }}
        mobile={{ x: 20, y: 5429, w: 340 }}>
        <div class="scrap-text">
          <p>I like it here. The thing I miss most, absurdly, is 220&nbsp;volts — back home the
          microwaves hit harder and the hair dryers actually meant business.</p>
          <p>More than anything, I like that this country isn't built on the backs of the poor. You
          could afford a beautiful life in India precisely because everything is cheap — and
          everything is cheap because it is taken from people paid almost nothing: the men who pour
          the concrete, the house help, the drivers, the guards, the shopkeepers. The West doesn't
          come with those conveniences, and I'll take the trade. I'd rather live where the wealth is
          shared more evenly.</p>
          <p>I walk more here. The city makes it easy, and I've come to love it.</p>
        </div>
      </Place>

      {/* Antarctica — a pair */}
      <Place id="p-antarctica1" saved={layout['p-antarctica1']}
        x={700} y={2010} rotate={-2} z={2} w={280}
        tablet={{ x: 230, y: 4470, rotate: -2, w: 300 }}
        mobile={{ x: 30, y: 6040, rotate: -2, w: 320 }}>
        <Polaroid src="/images/antarctica-1.jpg" alt="Aditi and Navid bundled up on a snowy slope in Antarctica" caption="Antarctica" />
      </Place>

      <Place id="p-antarctica2" saved={layout['p-antarctica2']}
        x={992} y={2010} rotate={3} z={2} w={280}
        tablet={{ x: 230, y: 4786, rotate: 3, w: 300 }}
        mobile={{ x: 30, y: 6375, rotate: 3, w: 320 }}>
        <Polaroid src="/images/antarctica-2.jpg" alt="Two people play-fighting on the ice with an expedition ship and icebergs behind" caption="the end of the world" />
      </Place>

      {/* ===== Section break (desktop only; a gap reads it on narrow screens) ===== */}
      <Place id="divider" saved={layout.divider} class="cv-desktop-only"
        x={96} y={2110} z={1}>
        <Scribble type="squiggle" w={420} h={26} seed={5} color="var(--text-muted)" />
      </Place>

      {/* ===== Act 2 — career ===== */}
      <Place id="t-career" saved={layout['t-career']}
        x={96} y={2186} rotate={-0.4} w={560}
        tablet={{ x: 40, y: 5107, w: 600 }}
        mobile={{ x: 20, y: 6716, w: 340 }}>
        <div class="scrap-text">
          <p>I've been a software engineer for twelve years. Like a lot of us, I started by
          teaching myself, and I've kept teaching myself most of what I know since. I'm proud of
          that — the quiet pride of having drawn my own map.</p>
          <p>There's almost nothing I love more than building. Right now I've got a bad case of
          LLM psychosis: suddenly too much is possible, I want to build all of it at once, and I
          burn through tokens like they're free.</p>
        </div>
      </Place>

      <Place id="t-bigdrop" saved={layout['t-bigdrop']}
        x={108} y={2560} rotate={0.4} w={560}
        tablet={{ x: 40, y: 5422, w: 600 }}
        mobile={{ x: 20, y: 7135, w: 340 }}>
        <div class="scrap-text">
          <p>I never really decided to start a company; I just wanted to build, and one thing led
          to the next. I was already building in university, spending far more time on my own code
          than on anything I was supposed to be doing. I'd come to hate math by then anyway.</p>
          <p>So I dropped out of the Noida Institute of Engineering and Technology (🤮) and started
          an IT services firm in Gurgaon called <strong>Big Drop</strong>. A few years later it was
          <a href="https://inc42.com/buzz/appworks-acquires-bigdrop/" rel="noopener">acquired</a>.</p>
        </div>
      </Place>

      {/* Big Drop logo, pinned beside that paragraph */}
      <Place id="logo-bigdrop" saved={layout['logo-bigdrop']}
        x={688} y={2500} rotate={-4} z={3} w={150}
        tablet={{ x: 600, y: 4145, rotate: -4, w: 120 }}
        mobile={{ x: 242, y: 7540, rotate: -4, w: 110 }}>
        <img class="logo-mark" src="/images/bigdrop-logo.png" alt="Big Drop logo" loading="lazy" />
      </Place>

      <Place id="p-niet" saved={layout['p-niet']}
        x={744} y={2600} rotate={-3} z={2} w={330}
        tablet={{ x: 230, y: 5692, rotate: -3, w: 300 }}
        mobile={{ x: 30, y: 7719, rotate: -3, w: 320 }}>
        <Polaroid src="/images/niet.webp" alt="Aerial view of NIET campus" caption="NIET — the one I left 🤮" />
      </Place>

      <Place id="t-canary" saved={layout['t-canary']}
        x={92} y={2859} rotate={-0.3} w={560}
        tablet={{ x: 40, y: 5919, w: 600 }}
        mobile={{ x: 20, y: 7959, w: 340 }}>
        <div class="scrap-text">
          <p>After that came <strong>Square1</strong> — meant to be a Shopify for India, before
          Shopify itself arrived and got big there. It went through India Accelerator and the Global
          Accelerator Network, and it didn't make it. Not everything does.</p>
          <p>These days I'm at Canary Technologies, building software for hotels. I joined as the
          sixth engineer and the twenty-first employee. It's where I learned to be a serious
          engineer; most of the principles I hold close came from my years there.</p>
        </div>
      </Place>

      {/* Square1 logo, pinned beside that paragraph */}
      <Place id="logo-square1" saved={layout['logo-square1']}
        x={684} y={2872} rotate={4} z={3} w={120}
        tablet={{ x: 612, y: 5919, rotate: 4, w: 96 }}
        mobile={{ x: 260, y: 8377, rotate: 4, w: 92 }}>
        <img class="logo-mark" src="/images/square1-logo.png" alt="Square1 logo" loading="lazy" />
      </Place>

      <Place id="t-close" saved={layout['t-close']}
        x={104} y={3128} rotate={0.4} w={560}
        tablet={{ x: 40, y: 6188, w: 600 }}
        mobile={{ x: 20, y: 8523, w: 340 }}>
        <div class="scrap-text">
          <p>I'm electrified by what AI has cracked open — it's most of what I think about now, and
          I want to build so much more.</p>
          <p>Software gave me this whole life; it's my greatest passion. I came from a small place, a
          long way from here, and not many people make it out. I'm proud of the road, I'm happy, and
          I'm nowhere near done.</p>
        </div>
      </Place>

      {/* the dry closer, as a handwritten aside */}
      <Place id="aside-code" saved={layout['aside-code']}
        x={712} y={3150} rotate={-5} z={3} w={300}
        tablet={{ x: 360, y: 6520, rotate: -5, w: 320 }}
        mobile={{ x: 24, y: 8854, rotate: -4, w: 320 }}>
        <p class="scrap-aside">When I'm tired from work, I code to relax.</p>
      </Place>

      <Place id="email" saved={layout.email}
        x={104} y={3349} rotate={-1} z={3} w={520}
        tablet={{ x: 40, y: 6428, w: 600 }}
        mobile={{ x: 20, y: 8991, w: 340 }}>
        <p class="scrap-email">Reach me at n@nvdk.co.</p>
      </Place>

      {/* ===== Footer — doodles scattered across the very bottom ===== */}
      {doodles.map((dd, i) => (
        <Place id={`doodle-${dd.name}`} saved={layout[`doodle-${dd.name}`]}
          x={fp.desktop[i].x} y={fp.desktop[i].y} rotate={footerRot[i]} z={1 + (i % 5)}
          tablet={{ x: fp.tablet[i].x, y: fp.tablet[i].y, rotate: footerRot[i] }}
          mobile={{ x: fp.mobile[i].x, y: fp.mobile[i].y, rotate: footerRot[i] }}>
          <Doodle name={dd.name} size={fp.desktop[i].size} color={dd.color} seed={i + 2} />
        </Place>
      ))}
    </Canvas>
  </div>
</Layout>

<style>
  .scrap-head { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
  .scrap-title {
    font-family: 'Caveat', var(--font-serif);
    font-size: 2.9rem;
    line-height: 0.95;
    color: #fff;
  }
  .scrap-head :global(.cv-scribble) { margin-left: 6px; }

  .scrap-text {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--text-primary);
  }
  .scrap-text p { margin-bottom: 16px; }
  .scrap-text p:last-child { margin-bottom: 0; }
  .scrap-text strong { color: #fff; font-weight: 600; }
