---
import Layout from '../../components/Layout.astro';
import Canvas from '../../components/canvas/Canvas.astro';
import Place from '../../components/canvas/Place.astro';
import Scribble from '../../components/canvas/Scribble.astro';
import { getEntry } from 'astro:content';
import { loadLayout } from '../../utils/layout';

// Bespoke canvas treatment for this post. Frontmatter still lives in the
// collection entry (drives the home post-it, archive, RSS); this page replaces
// the generic /wip/[...slug] renderer for this one slug (excluded there).
const entry = await getEntry('posts', 'browser-plugin-for-ui-design');
const { title, date, summary } = entry!.data;
const layout = loadLayout('browser-plugin');

const postUrl = new URL('/wip/browser-plugin-for-ui-design/', Astro.site).toString();
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: 'Navid Khan', url: 'https://nvdk.co/' },
  mainEntityOfPage: postUrl,
  url: postUrl,
  image: new URL('/og-default.png', Astro.site).toString(),
};
const dateLabel = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<Layout
  title={`${title} — Navid Khan`}
  description={summary}
  ogType="article"
  publishedTime={date.toISOString()}
  canonicalPath="/wip/browser-plugin-for-ui-design/"
  jsonLd={blogPostingLd}
>
  <div class="canvas-page">
    <Canvas page="browser-plugin" width={1280} height={1520} tabletHeight={1820} mobileHeight={2740}>
      {/* ---- Header ---- */}
      <Place
        id="title" saved={layout.title}
        x={72} y={12} w={760}
        tablet={{ x: 40, y: 12, w: 680 }}
        mobile={{ x: 20, y: 12, w: 340 }}
      >
        <h1 class="bp-title">{title}</h1>
        <div class="bp-meta">{dateLabel} · WIP</div>
      </Place>

      <Place
        id="lede" saved={layout.lede}
        x={72} y={108} w={640}
        tablet={{ x: 40, y: 106, w: 680 }}
        mobile={{ x: 20, y: 148, w: 340 }}
      >
        <p class="bp-lede">
          Same job both times: produce a modified version of our UI, fast, without a
          designer or engineer hand-building each one.
        </p>
      </Place>

      {/* ---- Use cases ---- */}
      <Place
        id="usecases-label" saved={layout['usecases-label']}
        x={72} y={208} z={3}
        tablet={{ x: 40, y: 188 }}
        mobile={{ x: 20, y: 258 }}
      >
        <span class="bp-label">What we keep needing</span>
      </Place>

      <Place
        id="card-demos" saved={layout['card-demos']}
        x={72} y={236} rotate={-1} w={300}
        tablet={{ x: 40, y: 230, w: 330 }}
        mobile={{ x: 20, y: 296, rotate: 0, w: 340 }}
      >
        <div class="bp-card">
          <span class="bp-card-tag">demos</span>
          <p>Rebranded versions of the product for whichever enterprise prospect sales is
          pitching — their branding, their data, the right feature flags.</p>
        </div>
      </Place>

      <Place
        id="card-tickets" saved={layout['card-tickets']}
        x={404} y={244} rotate={1} w={320}
        tablet={{ x: 400, y: 230, w: 330 }}
        mobile={{ x: 20, y: 460, rotate: 0, w: 340 }}
      >
        <div class="bp-card">
          <span class="bp-card-tag">quick designs for eng tickets</span>
          <p>Show a UI change — sometimes small, sometimes bigger — well enough that the team
          can react to it. Today: a screenshot into Figma Make, then iterate.</p>
        </div>
      </Place>

      {/* ---- The fork ---- */}
      <Place
        id="twoways" saved={layout.twoways}
        x={72} y={408} rotate={-1} z={3}
        tablet={{ x: 40, y: 435 }}
        mobile={{ x: 20, y: 636 }}
      >
        <span class="bp-fork">Two ways to do it</span>
      </Place>

      {/* ---- Track A ---- */}
      <Place
        id="track-a" saved={layout['track-a']}
        x={72} y={470} w={544}
        tablet={{ x: 40, y: 503, w: 680 }}
        mobile={{ x: 20, y: 704, w: 340 }}
      >
        <div class="bp-track">
          <h2 class="bp-track-head"><span class="bp-track-key">A</span> Copy &amp; edit</h2>
          <p>Make a static copy of the frontend, sample data baked in. A coding agent recolors
          it to spin up demo environments; the chatbot is the front door — point it at the
          customer's site, it rebrands.</p>
          <p>We built this. It works. Three problems:</p>
          <ul class="bp-problems">
            <li><strong>The copy drifts.</strong> Changes to the real frontend don't show up in
            the copy. Someone has to keep them in sync. This is the one that bothers me most.</li>
            <li><strong>Making it look good is slow.</strong> Many rounds with the agent — worse
            because the people driving it are non-technical (sales).</li>
            <li><strong>It just moves the cost center.</strong> Not paying for design anymore.
            Paying for engineering.</li>
          </ul>
          <p>Take it seriously anyway. What would it actually need? A model that looks at the
          product the way a person does — screenshots, the rendered DOM and HTML, the source.
          We have all of that. The only real bar: can it do it well enough to stop needing
          constant steering?</p>
          <p>Right now it can't — even Opus needs steering. But copying a whole codebase was
          never realistic before (months). Now it's two or three weeks. Still horrible work,
          and maybe the human isn't needed: if the code is throwaway — never ships, all black
          boxes — maybe nobody steers. Just a loop that keeps inspecting until an agent can
          pass it off.</p>
        </div>
      </Place>

      {/* ---- Track B ---- */}
      <Place
        id="track-b" saved={layout['track-b']}
        x={700} y={470} w={500}
        tablet={{ x: 40, y: 1155, w: 680 }}
        mobile={{ x: 20, y: 1784, w: 340 }}
      >
        <div class="bp-track">
          <h2 class="bp-track-head"><span class="bp-track-key">B</span> Live edit</h2>
          <p>No copy. Open the actual page — real branding, real data, real feature flags — and
          the page is the canvas. Describe a change; an agent reads the DOM, writes a bit of CSS
          or JS, injects it. Nothing to sync, because there's nothing to sync. You're already on
          the thing you'd ship.</p>
          <p>Its own problems:</p>
          <ul class="bp-problems">
            <li><strong>Complex apps resist JS injection.</strong> The agent has to work very
            hard to change anything structural.</li>
            <li><strong>Easy things stay easy, hard things stay hard.</strong> Colors and text,
            fine. Beyond that it's like Claude Code in a stripped-down environment — almost no
            tools — and the Max plans need handholding for decent quality.</li>
          </ul>
        </div>
      </Place>

      {/* ---- Synthesis ---- */}
      <Place
        id="lands" saved={layout.lands}
        x={72} y={1300} w={1130}
        tablet={{ x: 40, y: 1569, w: 680 }}
        mobile={{ x: 20, y: 2384, w: 340 }}
      >
        <div class="bp-track">
          <span class="bp-label">Where it lands</span>
          <p>Both bottleneck on the same thing: a model that can look at a UI and change it well
          without someone steering every step. A is feasible-but-grim manual work that might not
          even need a human. B is cleaner in principle but blocked on complex apps.</p>
          <p class="bp-question">So is there a way to do this yet? Or are we just early?</p>
        </div>
      </Place>

      {/* ---- Decoration ---- */}
      <Place
        id="fork-arrow-a" saved={layout['fork-arrow-a']} class="cv-desktop-only"
        x={250} y={430} rotate={28} z={1}
      >
        <Scribble type="arrow" w={120} h={60} seed={4} color="var(--text-muted)" />
      </Place>

      <Place
        id="fork-arrow-b" saved={layout['fork-arrow-b']} class="cv-desktop-only"
        x={560} y={432} rotate={-6} z={1}
      >
        <Scribble type="arrow" w={150} h={60} seed={7} color="var(--text-muted)" />
      </Place>

      <Place
        id="divider" saved={layout.divider} class="cv-hide-mobile"
        x={250} y={870} rotate={90} z={0}
        tablet={{ x: 40, y: 1138, rotate: 0 }}
      >
        <Scribble type="line" w={760} h={14} seed={3} color="var(--border-color-strong)" />
      </Place>
    </Canvas>
  </div>
</Layout>

<style>
  .bp-title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 500;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .bp-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-top: 10px;
  }
  .bp-lede {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.4;
    color: var(--text-primary);
    font-style: italic;
  }
  .bp-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-color);
  }
  .bp-card {
    border: 1px solid var(--border-color-strong);
    background: var(--code-bg);
    border-radius: 3px;
    padding: 14px 16px;
  }
  .bp-card-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-color);
    display: block;
    margin-bottom: 8px;
  }
  .bp-card p {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .bp-fork {
    font-family: 'Caveat', var(--font-serif);
    font-size: 1.9rem;
    color: #fff;
  }
  .bp-track-head {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .bp-track-key {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-color);
    border: 1px solid var(--accent-color);
    border-radius: 3px;
    padding: 2px 9px;
    letter-spacing: 0;
  }
  .bp-track p {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-primary);
    margin-bottom: 16px;
  }
  .bp-problems {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bp-problems li {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--text-secondary);
    padding-left: 18px;
    position: relative;
  }
  .bp-problems li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent-color);
  }
  .bp-problems strong { color: #fff; font-weight: 600; }
  .bp-question {
    font-family: 'Caveat', var(--font-serif);
    font-size: 1.7rem !important;
    line-height: 1.2 !important;
    color: var(--accent-color) !important;
    margin-top: 4px;
  }

  @media (max-width: 1023px) {
    .bp-lede { font-size: 1.2rem; }
  }
</style>
