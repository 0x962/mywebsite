---
/**
 * Chrome-less widget route. Each /widgets/<name> renders a single widget with no
 * site layout and a transparent background, so it sits cleanly inside an
 * Excalidraw `embeddable` (iframe) on the canvas. Allow-listed by
 * validateEmbeddable in ExcalidrawCanvas (same-origin /widgets/ only).
 */
import WidgetDemo from '../../components/widgets/WidgetDemo.tsx';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>widget: demo</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: transparent;
      }
      body {
        display: grid;
        place-items: center;
      }
    </style>
  </head>
  <body>
    <WidgetDemo client:load />
  </body>
</html>
