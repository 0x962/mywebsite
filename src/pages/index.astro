---
// SSR so we can honour KV publish overrides (set via /admin's toggle) without
// rebuilding. Layout still loads from src/data/layouts/index.json at build.
export const prerender = false;
import Layout from '../components/Layout.astro';
import Canvas from '../components/canvas/Canvas.astro';
import Place from '../components/canvas/Place.astro';
import Scribble from '../components/canvas/Scribble.astro';
import PostIt from '../components/canvas/PostIt.astro';
import { loadLayout } from '../utils/layout';
import { publishedPosts, readAllPosts } from '../lib/posts';

const layout = loadLayout('index');

const posts = publishedPosts(await readAllPosts(Astro.locals.runtime.env.POSTS));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// Per-post placement on the canvas. Index 0 = newest. Colours cycle; positions
// are authored per breakpoint. A 4th+ post falls into a tidy stacked column.
const slots = [
  {
    color: 'amber' as const,
    desktop: { x: 812, y: 96, rotate: 3, w: 268, z: 3 },
    tablet: { x: 96, y: 372, rotate: 2, w: 280 },
    mobile: { x: 22, y: 452, rotate: 1, w: 330 },
  },
  {
    color: 'blue' as const,
    desktop: { x: 690, y: 432, rotate: -3, w: 268, z: 2 },
    tablet: { x: 392, y: 540, rotate: -2, w: 280 },
    mobile: { x: 32, y: 636, rotate: -1.5, w: 330 },
  },
  {
    color: 'green' as const,
    desktop: { x: 968, y: 556, rotate: 2, w: 268, z: 2 },
    tablet: { x: 150, y: 724, rotate: 1.5, w: 280 },
    mobile: { x: 22, y: 824, rotate: 1, w: 330 },
  },
];
const slotFor = (i: number) =>
  slots[i] ?? {
    color: (['amber', 'blue', 'green', 'pink', 'paper'] as const)[i % 5],
    desktop: { x: 820, y: 760 + (i - 3) * 230, rotate: i % 2 ? 2 : -2, w: 268, z: 2 },
    tablet: { x: 150, y: 920 + (i - 3) * 230, rotate: i % 2 ? 2 : -2, w: 280 },
    mobile: { x: 24, y: 860 + (i - 3) * 200, rotate: i % 2 ? 1 : -1, w: 320 },
  };

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Navid Khan',
  url: 'https://nvdk.co/',
  image: 'https://nvdk.co/images/profile.png',
  jobTitle: 'Software Engineer',
  worksFor: { '@type': 'Organization', name: 'Canary Technologies' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Oakville',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Navid Khan',
  url: 'https://nvdk.co/',
};
---
<Layout
  title="Navid Khan — WIP"
  description="The open workspace of Navid Khan — work-in-progress notes, essays, and rough drafts on software, AI, and building things."
  jsonLd={[personLd, websiteLd]}
>
  <div class="canvas-page">
    <Canvas page="index" width={1280} height={920} tabletHeight={1000} mobileHeight={1010}>
      <h1 class="sr-only">Navid Khan — an open workspace of work-in-progress notes</h1>

      {/* The intro, in cursive — the voice of the place. */}
      <Place
        id="intro" saved={layout.intro}
        x={104} y={48} rotate={-1} z={4} w={560}
        tablet={{ x: 48, y: 36, w: 600 }}
        mobile={{ x: 20, y: 24, rotate: 0, w: 340 }}
      >
        <div class="canvas-intro">
          <p>Everything here is a work in progress &mdash; that's the whole idea.</p>
          <p>
            I never finish side projects; I move on long before they're good enough to show.
            So I stopped waiting for &ldquo;done.&rdquo; Everything goes up from the first line,
            half-built and rough, and gets better in public (or doesn't).
          </p>
          <p class="canvas-intro-kicker">This is my thinkspace, public.</p>
        </div>
      </Place>

      {/* The posts, as scattered sticky notes. Real links, real text.
          Place IDs are slug-based (`post-${slug}`) so the drag-editor's
          saved layout stays attached to the right post if the date order
          shifts later. The slot still cycles by index for visual variety. */}
      {posts.map((post, i) => {
        const s = slotFor(i);
        const layoutId = `post-${post.slug}`;
        return (
          <Place
            id={layoutId} saved={layout[layoutId]}
            x={s.desktop.x} y={s.desktop.y} rotate={s.desktop.rotate} z={s.desktop.z} w={s.desktop.w}
            tablet={s.tablet}
            mobile={s.mobile}
          >
            <PostIt
              href={`/post/${post.slug}/`}
              title={post.title}
              summary={post.summary || undefined}
              date={fmtDate(new Date(post.createdAt))}
              color={s.color}
              slug={post.slug}
            />
          </Place>
        );
      })}

      {/* Decoration — all aria-hidden, drawn last so it never leads the reading order. */}
      <Place
        id="arrow" saved={layout.arrow} class="cv-hide-mobile"
        x={636} y={150} rotate={-6} z={1}
        tablet={{ x: 300, y: 312, rotate: 54 }}
      >
        <Scribble type="arrow" w={150} h={70} seed={4} />
      </Place>

      <Place
        id="underline" saved={layout.underline} class="cv-hide-mobile"
        x={104} y={250} rotate={0} z={1}
        tablet={{ x: 48, y: 250 }}
      >
        <Scribble type="underline" w={330} h={16} seed={9} color="var(--accent-color)" />
      </Place>

      <Place
        id="jot" saved={layout.jot}
        x={812} y={372} rotate={-4} z={4}
        tablet={{ x: 486, y: 468, rotate: -3 }}
        mobile={{ x: 24, y: 410, rotate: -3 }}
      >
        <span class="canvas-jot">rough drafts &darr;</span>
      </Place>

      <Place
        id="squiggle" saved={layout.squiggle} class="cv-hide-mobile"
        x={1108} y={300} rotate={8} z={0}
        tablet={{ x: 600, y: 200 }}
      >
        <Scribble type="squiggle" w={120} h={40} seed={2} color="var(--text-muted)" />
      </Place>
    </Canvas>
  </div>
</Layout>

<style>
  .canvas-intro {
    font-family: 'Caveat', 'IBM Plex Serif', Georgia, serif;
    font-size: 1.95rem;
    line-height: 1.3;
    color: #ffffff;
  }
  .canvas-intro p { margin: 0 0 16px; }
  .canvas-intro p:last-child { margin-bottom: 0; }
  .canvas-intro-kicker { color: var(--accent-color); }

  @media (max-width: 639px) {
    .canvas-intro { font-size: 1.5rem; }
    .canvas-intro p { margin-bottom: 12px; }
  }

  /* a handwritten margin jot */
  .canvas-jot {
    font-family: 'Caveat', 'IBM Plex Serif', Georgia, serif;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--text-secondary);
    white-space: nowrap;
  }
</style>
