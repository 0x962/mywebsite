---
/**
 * /post/<slug> — dynamic canvas post page for posts created via /admin
 * (metadata stored in KV). Existing frontmatter posts continue to live at
 * /wip/<slug>/. SSR'd because slugs are not known at build time.
 */
export const prerender = false;

import ExcalidrawCanvas from '../../components/excalidraw/ExcalidrawCanvas.tsx';
import { readPostMeta, isSlug } from '../../lib/scenes';

const slug = Astro.params.slug;
if (!isSlug(slug)) return new Response('not found', { status: 404 });

const meta = await readPostMeta(Astro.locals.runtime.env.SCENES, slug);
if (!meta) return new Response('not found', { status: 404 });

const canonical = new URL(`/post/${slug}/`, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
const pageTitle = `${meta.title} — Navid Khan`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Navid Khan" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <title>{pageTitle}</title>
    <meta name="description" content={meta.summary} />
    {meta.draft && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={meta.summary} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    <style>
      html, body { margin: 0; height: 100%; background: #0a0a0b; }
      .ex-home-link {
        position: fixed; top: 14px; right: 16px; z-index: 5;
        font: 13px/1 'JetBrains Mono', ui-monospace, monospace;
        color: #d4d4d8; text-decoration: none;
        background: rgba(15, 15, 16, 0.85);
        border: 1px solid #27272a; border-radius: 6px; padding: 7px 10px;
      }
      .ex-home-link:hover { color: #fff; border-color: #3b82f6; }
      .ex-edited {
        position: fixed; top: 14px; left: 16px; z-index: 5;
        font: 11px/1 'JetBrains Mono', ui-monospace, monospace;
        color: #71717a; background: rgba(15, 15, 16, 0.65);
        border: 1px solid #27272a; border-radius: 6px; padding: 6px 9px;
        letter-spacing: 0.02em; pointer-events: none;
      }
      .ex-edited:empty { display: none; }
    </style>
  </head>
  <body>
    <a class="ex-home-link" href="/">← nvdk.co</a>
    <span class="ex-edited" data-slug={slug}></span>
    <ExcalidrawCanvas client:only="react" slug={slug} />
    <script is:inline define:vars={{ slug }}>
      (async () => {
        if (new URLSearchParams(location.search).has('edit')) return;
        const el = document.querySelector(`.ex-edited[data-slug="${slug}"]`);
        if (!el) return;
        try {
          const res = await fetch(`/data/meta/${encodeURIComponent(slug)}`, { cache: 'no-store' });
          if (!res.ok) return;
          const { lastEditedAt } = await res.json();
          if (!lastEditedAt) return;
          const sec = Math.max(0, (Date.now() - Date.parse(lastEditedAt)) / 1000);
          let ago;
          if (sec < 90) ago = 'just now';
          else if (sec < 3600) ago = `${Math.round(sec / 60)}m ago`;
          else if (sec < 36 * 3600) ago = `${Math.round(sec / 3600)}h ago`;
          else if (sec < 14 * 86400) ago = `${Math.round(sec / 86400)}d ago`;
          else if (sec < 70 * 86400) ago = `${Math.round(sec / (7 * 86400))}w ago`;
          else if (sec < 540 * 86400) ago = `${Math.round(sec / (30.4 * 86400))}mo ago`;
          else ago = `${Math.round(sec / (365.25 * 86400))}y ago`;
          el.textContent = `edited ${ago}`;
        } catch { /* leave empty */ }
      })();
    </script>
  </body>
</html>
