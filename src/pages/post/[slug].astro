---
/**
 * /post/<slug> — dynamic canvas post page for posts created via /admin
 * (metadata stored in KV). Existing frontmatter posts continue to live at
 * /wip/<slug>/. SSR'd because slugs are not known at build time.
 */
export const prerender = false;

import '../../styles/global.css';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import TopBar from '../../components/TopBar.astro';
import ExcalidrawCanvas from '../../components/excalidraw/ExcalidrawCanvas.tsx';
import { readPostMeta, isSlug } from '../../lib/scenes';

const slug = Astro.params.slug;
if (!isSlug(slug)) return new Response('not found', { status: 404 });

const meta = await readPostMeta(Astro.locals.runtime.env.SCENES, slug);
if (!meta) return new Response('not found', { status: 404 });

const canonical = new URL(`/post/${slug}/`, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
const pageTitle = `${meta.title} — Navid Khan — WIP`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Navid Khan" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <title>{pageTitle}</title>
    <meta name="description" content={meta.summary} />
    {meta.draft && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={meta.summary} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    <style>
      html, body { margin: 0; height: 100%; background: #0a0a0b; }
      :global(.excalidraw-stage) {
        position: fixed;
        top: var(--topbar-height, 56px);
        left: 0; right: 0; bottom: 0;
      }
      :global(.excalidraw .App-toolbar-container) {
        position: fixed !important;
        left: 50% !important;
        bottom: 20px !important;
        transform: translateX(-50%);
        z-index: 5;
      }
    </style>
  </head>
  <body>
    <TopBar />
    <ExcalidrawCanvas client:only="react" slug={slug} />
  </body>
</html>
