---
import Layout from '../components/Layout.astro';

// Update when focus shifts.
const updated = new Date('2026-05-08');
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Layout
  title="Now — Navid Khan"
  description="What I'm currently working on."
>
  <div class="manuscript">
    <aside class="gutter">
      <div>UPDATED</div>
      <div style="margin-top: 8px;">{fmt(updated)}</div>
    </aside>
    <main class="content">
      <span class="section-label">— Now</span>
      <div class="about-body">
        {/* TODO: what I'm working on right now */}
      </div>
    </main>
  </div>
</Layout>
